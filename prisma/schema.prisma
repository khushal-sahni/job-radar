generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ruleSets  RuleSet[]
  resumes   Resume[]
}

model RuleSet {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("Default")
  rules     Json
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Resume {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  rawText   String   @db.Text
  skills    String[]
  seniority String?
  roles     String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Job {
  id              String           @id @default(cuid())
  externalId      String
  source          String
  title           String
  company         String
  description     String           @db.Text
  url             String
  location        String?
  country         String?
  isRemote        Boolean          @default(false)
  remoteScope     String?
  visaSponsorship Boolean?
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String?
  salaryINRMin    Float?
  salaryINRMax    Float?
  isBaseSalary    Boolean?
  salaryEstimated Boolean          @default(false)
  salaryVerified  Boolean          @default(false)
  visaVerified    Boolean          @default(false)
  enrichmentModel String?
  tags            String[]
  postedAt        DateTime?
  fetchedAt       DateTime         @default(now())
  enrichedAt      DateTime?
  isActive        Boolean          @default(true)
  requiredYearsMin Int?
  requiredYearsMax Int?
  application     JobApplication?
  applyTask       ApplyTask?

  @@unique([source, externalId])
  @@index([country, isRemote])
  @@index([salaryINRMin])
  @@index([isActive, enrichedAt])
}

model JobApplication {
  id        String            @id @default(cuid())
  jobId     String            @unique
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(APPLIED)
  appliedAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
}

enum ApplicationStatus {
  APPLIED
  NOT_INTERESTED
  SAVED
  INTERVIEWING
  REJECTED
  OFFER
}

model ApplyTask {
  id          String          @id @default(cuid())
  jobId       String          @unique
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      ApplyTaskStatus @default(QUEUED)
  vendor      String
  /// Why the task is where it is, for code to act on. `lastError` is the sentence shown to the user.
  code        ApplyIssue?
  lastError   String?         @db.Text
  attempts    Int             @default(0)
  submittedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  questions   ApplyQuestion[]

  @@index([status])
  @@index([submittedAt])
}

enum ApplyTaskStatus {
  QUEUED
  IN_PROGRESS
  NEEDS_ANSWER
  NEEDS_YOU
  SUBMITTED
  FAILED
}

enum ApplyIssue {
  // Not the task's fault; never uses up a try
  captcha
  login_required
  challenge
  browser
  // Waiting on you
  questions
  security_code
  cannot_answer
  not_understood
  file_required
  missing_answer
  form_rejected
  audit_failed
  contradiction
  no_form
  account_required
  no_submit
  no_confirmation
  too_many_steps
  company_site
  linkedin
  left_open
  // Finished or bookkeeping
  closed
  /// The form's fixed location list has no India, Germany or Japan
  ineligible
  dry_run
  error
  stopped
  manual
}

model ApplyQuestion {
  id          String    @id @default(cuid())
  taskId      String
  task        ApplyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fingerprint String
  genericKey  String
  prompt      String    @db.Text
  control     String
  options     String[]
  required    Boolean   @default(true)
  maxLength   Int?
  /// Set when the question asks for an applicant fact; the answer is saved as that fact.
  factKey     String?
  factType    String?
  answer      String?   @db.Text
  answeredAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([taskId, fingerprint])
  @@index([fingerprint])
  @@index([genericKey])
}

model FieldRecipe {
  id          String       @id @default(cuid())
  fingerprint String       @unique
  genericKey  String
  label       String       @db.Text
  action      Json
  source      RecipeSource
  model       String?
  uses        Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([genericKey])
}

/// One fact about the applicant. Form answers are rendered from these, never guessed.
model ApplicantFact {
  id        String   @id @default(cuid())
  /// "skill.nodejs.professional", "llm_providers.professional", "education.bachelor.result"
  key       String   @unique
  /// Neutral wording shown in the questions modal and Settings.
  question  String   @db.Text
  /// boolean | text | number | list
  type      String
  value     Json
  /// Lists only: true means nothing outside the list applies.
  complete  Boolean  @default(false)
  /// resume | user | settings
  source    String
  evidence  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// What a form question asks, decided once per wording by a cheap model call.
model QuestionMap {
  /// Hash of the normalized label and options; company-scoped when the question names the company.
  key       String   @id
  label     String   @db.Text
  /// fact | preference | written | demographic | consent | instruction | derived
  kind      String
  factKey   String?
  /// Proposed fact question / type, the item a yes/no asks about, a threshold.
  detail    Json?
  model     String?
  createdAt DateTime @default(now())

  @@index([factKey])
}

enum RecipeSource {
  heuristic
  cheap_model
  strong_model
  user
}

model Preferences {
  id                         String   @id @default("default")
  yearsOfExperience          Int      @default(4)
  excludeTitleKeywords       String[] @default(["staff"])
  avoidIfExclusiveLanguages  String[] @default(["java"])
  findScheduleEnabled        Boolean  @default(false)
  applyScheduleEnabled       Boolean  @default(false)
  scheduleHour               Int      @default(8)
  dailyApplyCap              Int      @default(15)
  naukriEnabled              Boolean  @default(false)
  updatedAt                  DateTime @updatedAt
}

model UserProfile {
  id              String   @id @default("default")
  firstName       String   @default("")
  lastName        String   @default("")
  email           String   @default("")
  phone           String   @default("")
  location        String   @default("")
  linkedInUrl     String   @default("")
  githubUrl       String   @default("")
  portfolioUrl    String   @default("")
  currentCompany  String   @default("")
  noticePeriod    String   @default("")
  expectedCtc     String   @default("")
  resumeSummary   String   @default("") @db.Text
  resumeFilename  String?
  resumePdfBase64 String?  @db.Text
  updatedAt       DateTime @updatedAt
}
