# Optional. Leave unset for a new install — Job Radar starts an embedded
# database in your user-data folder. Set this only to use your own Postgres.
# DATABASE_URL=postgresql://jobradar:jobradar@localhost:5433/job_radar?schema=public

# Optional overrides (normally set in the Setup dialog / Settings UI):
# OPENROUTER_API_KEY=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# APPLY_DAILY_CAP=15
# APPLY_NAUKRI=0
